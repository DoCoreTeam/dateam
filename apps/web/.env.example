# ─────────────────────────────────────────────────────────────────────────────
# newAX 환경변수 목록 (SSOT)
#
# 왜 이 파일이 생겼나: 2026-08-21, 프로덕션(Vercel)에 환경변수가 5개만 있고
# 10개가 빠진 상태였는데 **아무도 알 수 없었다.** 저장소 어디에도 "이 앱이 무엇을
# 필요로 하는가"가 적혀 있지 않았기 때문이다. 그 결과 영업 CRM 전 화면이 500 이었고
# (`DATABASE_URL` 없음 → Prisma 초기화 실패), 화면에는 digest 숫자만 떴다.
#
# 값은 절대 적지 않는다. 이 파일은 **무엇이 필요한지의 목록**이고,
# 실제 값은 로컬 `.env.local`(gitignore)과 Vercel 프로젝트 설정에만 둔다.
#
# 새 환경변수를 코드에 추가하면 **여기에도 한 줄 추가한다.**
# 그러지 않으면 다음 사람은 또 배포하고 나서야 없다는 걸 알게 된다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 필수: Supabase (인증 + 주 DB) ───────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용(RLS 우회). 브라우저에 절대 노출 금지 — createAdminClient() 가 쓴다
SUPABASE_SERVICE_ROLE_KEY=

# ── 필수: 영업 CRM (Prisma) ─────────────────────────────────────────────────
# 없으면 /crm 전 화면이 500 이 된다(PrismaClientInitializationError).
# 서버리스에서는 반드시 pooler(:6543) + pgbouncer=true&connection_limit=1
DATABASE_URL=
# 마이그레이션·introspection 용 직결(:5432). schema.prisma 의 directUrl
DIRECT_URL=
# CRM 시크릿(외부 연동 키) 암호화 마스터 키. 없으면 시크릿 저장이 거절된다(평문 폴백 없음)
CRM_SETTING_KEY=

# ── 필수: 잡·크론 인증 ──────────────────────────────────────────────────────
# Vercel 크론이 Authorization: Bearer 로 자동 첨부한다. 없으면 vercel.json 의
# 크론이 전부 401/403 으로 죽는다 — 화면은 멀쩡해 보여서 눈치채기 어렵다
CRON_SECRET=
# 외부 스케줄러·pg_cron 이 잡을 부를 때 쓰는 토큰(CI 워커 · CRM 잡 공용)
CI_WORKER_TOKEN=
# work/autolink 워커 전용(pg_cron + pg_net 이 분당 호출)
AUTOLINK_CRON_SECRET=

# ── 필수: 외부 API 프로그램 ─────────────────────────────────────────────────
# 발급 API 키 해싱용 HMAC 시크릿
API_KEY_HMAC_SECRET=
# CI 설정 암호화 마스터 키
CI_SETTINGS_MASTER_KEY=

# ── 필수: 앱 주소 ───────────────────────────────────────────────────────────
# OAuth 콜백·절대 URL 생성 기준. 프로덕션에 localhost 를 넣으면 연동이 조용히 깨진다
NEXT_PUBLIC_APP_URL=

# ── 선택: Google Drive 연동 ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_APP_URL 과 같은 호스트여야 하고, Google Cloud Console 의
# "승인된 리디렉션 URI" 에도 똑같이 등록돼 있어야 한다
GOOGLE_REDIRECT_URI=

# ── 선택: AI ────────────────────────────────────────────────────────────────
# 비우면 DB(org_content META.gemini_api_key)에서 읽는다. 둘 다 없으면 AI 기능이 실패한다
GEMINI_API_KEY=

# ── 선택: 기능 플래그 ───────────────────────────────────────────────────────
# USAI 7단계 흡수 엔진 (기본 OFF, 1 로 활성)
GPU_USAI_INGEST=
NEXT_PUBLIC_GPU_UNIFIED=

# ── 로컬 개발 전용(배포에 넣지 않는다) ──────────────────────────────────────
# 공유 dev 서버(:3000)를 안 건드리고 두 번째 서버를 띄울 때 쓰는 빌드 출력 폴더
# NEXT_DIST_DIR=.next-mine
# scripts/migrate.sh 가 쓰는 DB 비밀번호
# PGPASSWORD=
