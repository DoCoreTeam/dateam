{
  "buildCommand": "cd ../.. && pnpm --filter web build",
  "outputDirectory": ".next",
  "installCommand": "cd ../.. && corepack enable pnpm && pnpm install",
  "framework": "nextjs",
  "regions": [
    "icn1"
  ],
  "git": {
    "deploymentEnabled": {
      "feature/weekly-week-continuity": false,
      "feature/usai-ingestion": false,
      "feature/meeting-relations": false,
      "feature/gpu-market-ai-extraction": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/analyze-drain",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/crm/jobs/gmail-sync",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/crm/jobs/expire-suggestions",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/crm/jobs/stalled-deals",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/meeting-notes/jobs/transcribe",
      "schedule": "*/2 * * * *"
    }
  ]
}
