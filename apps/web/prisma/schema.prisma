// ------------------------------------------------------------
// 그룹 G 시스템
// ------------------------------------------------------------

model CrmAuditLog {
  id          String       @id @default(cuid())
  workspaceId String
  actorType   CrmActorType
  actorId     String? // member id 또는 ai run id
  action      String // 예: deal.stage_moved, suggestion.accepted, setting.updated
  targetType  String
  targetId    String
  beforeJson  Json?
  afterJson   Json?
  createdAt   DateTime     @default(now())

  @@index([workspaceId, createdAt])
  @@index([workspaceId, targetType, targetId])
  @@map("crm_audit_log")
}

model CrmIntegrationConnection {
  id              String    @id @default(cuid())
  workspaceId     String
  memberId        String
  provider        String // google
  scopes          String
  accessTokenEnc  String // AES-GCM 암호화
  refreshTokenEnc String
  expiresAt       DateTime?
  gmailHistoryId  String? // 증분 동기화 커서
  status          String    @default("active") // active | revoked | error
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([workspaceId, memberId, provider])
  @@map("crm_integration_connection")
}

model CrmExchangeRate {
  id    String   @id @default(cuid())
  date  DateTime @db.Date
  base  String   @db.Char(3)
  quote String   @db.Char(3)
  rate  Decimal  @db.Decimal(18, 8)

  @@unique([date, base, quote])
  @@map("crm_exchange_rate")
}

// ------------------------------------------------------------
// 그룹 H 견적 (v0.7.540 신설)
//
// **왜 지금 만드나**: 딜에 금액 칸은 있는데 그 금액이 어디서 나왔는지 적을 곳이 없었다.
// 영업은 "얼마"를 항목으로 쪼개 제시하고(무엇을 몇 개, 단가 얼마, 할인 얼마),
// 그 문서가 곧 협상의 기준이 된다. 그 자리가 없으면 금액은 사람 머릿속에만 남는다.
// (사용자 지적: "견적 작성하는 기능은 존재하지도 않고")
//
// 설계 판단 셋
//   1) 금액은 전부 **minor 단위 BigInt** — CrmDeal.amountMinor 와 같은 규약이다.
//      소수 통화 계산을 부동소수로 하면 합계가 1원씩 어긋난다.
//   2) 합계 칸(subtotal·discount·tax·total)은 **저장하되 서버만 계산한다.**
//      화면이 보낸 합계를 그대로 믿으면 항목과 총액이 다른 견적서가 만들어진다.
//   3) 할인은 **임계를 넘으면 승인 없이는 보낼 수 없다.** 막는 게 아니라
//      "보내기"만 막는다 — 초안은 얼마든지 써 볼 수 있어야 협상 준비가 된다.
// ------------------------------------------------------------

enum CrmQuoteStatus {
  DRAFT // 작성 중 — 얼마든지 고칠 수 있다
  SENT // 보냄 — 고객에게 나간 상태
  ACCEPTED // 수락 — 딜 금액에 반영된다
  REJECTED // 거절
  EXPIRED // 유효기간 지남
}

/// 상품·서비스 카탈로그. 견적 항목이 여기서 단가를 가져온다(가져온 뒤엔 항목이 스스로 들고 있다).
model CrmProduct {
  id             String   @id @default(cuid())
  workspaceId    String
  name           String
  sku            String?
  /// 기본 단가. 견적에 넣는 순간 **항목으로 복사**된다 — 나중에 카탈로그 값이 바뀌어도
  /// 이미 보낸 견적서의 금액은 변하지 않아야 한다.
  unitPriceMinor BigInt   @default(0)
  currency       String   @db.Char(3)
  /// 부가세율(%). 0 이면 면세. 소수 세율을 위해 Decimal.
  taxRate        Decimal  @default(10) @db.Decimal(5, 2)
  unit           String? // '식', '개월', 'GPU/월' 같은 단위 표기
  descriptionMd  String?
  isActive       Boolean  @default(true)
  version        Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  workspace CrmWorkspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  lines     CrmQuoteLine[]

  @@index([workspaceId, isActive, name])
  @@map("crm_product")
}

model CrmQuote {
  id          String         @id @default(cuid())
  workspaceId String
  dealId      String
  /// 사람이 부르는 번호(Q-2026-0001). 워크스페이스 안에서 유일하다.
  quoteNo     String
  title       String
  status      CrmQuoteStatus @default(DRAFT)
  currency    String         @db.Char(3)
  /// 유효기간. 지나면 EXPIRED 로 본다(배치가 아니라 읽는 시점에 판정 — 배치는 놓치면 조용히 틀린다).
  validUntil  DateTime?

  /// ── 합계 (서버 계산 결과의 저장본) ──────────────────────────────
  /// 다시 계산하면 되는 값을 왜 저장하나: 목록에서 견적 100건의 총액을 보여줄 때
  /// 항목을 전부 읽어 더하면 조회가 100배가 된다. 쓰기는 한 곳(recalcQuote)뿐이라 어긋나지 않는다.
  subtotalMinor BigInt @default(0)
  discountMinor BigInt @default(0)
  taxMinor      BigInt @default(0)
  totalMinor    BigInt @default(0)

  /// ── 절사 지시 ──────────────────────────────────────────────
  /// 「끝자리를 떨어뜨려 주세요」를 견적이 기억한다. 단가를 손으로 조작해 맞추면
  /// 나중에 그 단가를 아무도 설명할 수 없고 원가 대비 마진도 거짓이 된다.
  /// 0 = 안 함. 그 외는 원 단위(1000·10000·100000·1000000).
  roundingUnit  Int    @default(0)
  /// DOWN(버림·기본) · NEAREST(반올림) · UP(올림)
  roundingMode  String @default("DOWN")
  /// 절사로 깎인 금액 — 서버가 계산해 저장한다(화면이 다시 계산하지 않는다)
  roundingMinor BigInt @default(0)

  /// 할인 승인 — 임계를 넘은 견적은 승인 전까지 보낼 수 없다
  approvalRequired Boolean   @default(false)
  approvedById     String? // CrmMember.id
  approvedAt       DateTime?

  notesMd     String?
  /// 이 견적이 고른 거래 조건. **순서가 곧 인쇄 순서**다.
  /// 연결 표로 만들면 순서를 또 저장해야 하고, 그 순서가 어긋난다
  termIds     String[] @default([])
  ownerId     String? // CrmMember.id
  /// 공급받는 곳의 담당자 — 「○○ 귀하」로 문서에 찍힌다. 안 고르면 회사 앞으로만 나간다
  recipientPersonId String?
  recipientPerson   CrmPerson? @relation("QuoteRecipient", fields: [recipientPersonId], references: [id], onDelete: SetNull)
  sentAt      DateTime?
  decidedAt   DateTime? // 수락·거절 시각
  version     Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  workspace CrmWorkspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  deal      CrmDeal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  lines     CrmQuoteLine[]
  sections  CrmQuoteSection[]

  @@unique([workspaceId, quoteNo])
  @@index([workspaceId, dealId, createdAt])
  @@index([workspaceId, status])
  @@map("crm_quote")
}

model CrmQuoteLine {
  id      String @id @default(cuid())
  quoteId String
  /// 카탈로그에서 골랐으면 그 흔적을 남긴다. 직접 입력한 항목은 null.
  /// 카탈로그가 지워져도 견적서는 남아야 하므로 SetNull 이다.
  productId String?

  /// 이름·단가는 **항목이 스스로 들고 있다**(카탈로그 참조가 아니다).
  /// 보낸 견적서의 금액이 나중에 바뀌면 그건 다른 문서다.
  name           String
  descriptionMd  String?
  quantity       Decimal @default(1) @db.Decimal(12, 3)
  unit           String?
  unitPriceMinor BigInt  @default(0)
  /// 항목 할인율(%). 금액 할인이 아니라 비율인 이유: 수량이 바뀌면 같이 따라가야 한다.
  /// 이것은 **기본(통상) 할인**이다 — 등급·정책에서 오는, 늘 들어가는 그 할인.
  discountPercent Decimal @default(0) @db.Decimal(5, 2)
  /// 특별 할인율(%). NULL 이면 없음. 값이 있으면 **이 값이 적용 할인율**이고
  /// 기본 할인율은 「원래는 이랬다」는 근거로만 남는다(곱하지 않는다).
  specialDiscountPercent Decimal? @db.Decimal(5, 2)
  /// 왜 특별가를 줬는지 — 승인·감사에서 이것이 근거가 된다
  specialDiscountReason  String?
  taxRate         Decimal @default(10) @db.Decimal(5, 2)
  /// 서버가 계산한 이 줄의 합계(할인 반영, 세금 제외)
  lineTotalMinor  BigInt  @default(0)
  position        Int     @default(0)

  /// 라인 종류 여섯. 새 유형은 enum 에 하나 더 — 표·화면·계산은 그대로다(기획 §08)
  kind            CrmQuoteLineKind @default(QUANTITY)
  /// 공수 라인: 역할과 등급이 품목 옆에 붙는다(M/M 견적서 양식)
  roleLabel       String?
  laborGradeId    String?
  /// 비율 라인: 어느 라인의 몇 %인지
  ratioOfLineId   String?
  ratioPct        Decimal? @db.Decimal(7, 4)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// 어느 묶음인지. NULL 이면 묶이지 않은 항목 — 섹션 표 아래에 그대로 선다.
  /// **SetNull 이다**: 섹션을 지워도 항목은 남는다(묶음만 푸는 것이지 물건을 버리는 게 아니다).
  sectionId String?

  quote      CrmQuote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  section    CrmQuoteSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  product    CrmProduct?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  laborGrade CrmLaborGrade?  @relation(fields: [laborGradeId], references: [id], onDelete: SetNull)
  costs      CrmDealCost[]

  @@index([quoteId, position])
  @@index([sectionId])
  @@map("crm_quote_line")
}

/// 견적 안의 묶음 — 「1. 하드웨어 / 2. 구축 / 3. 유지보수」.
///
/// **섹션은 선택이다.** 하나도 없으면 견적서는 예전처럼 한 표로 그려진다 —
/// 그래야 지금 있는 견적이 그대로 살아 있다.
model CrmQuoteSection {
  id          String @id @default(cuid())
  workspaceId String
  quoteId     String
  name        String
  /// 인쇄 순서
  position    Int    @default(0)
  /// 서버가 계산해 저장한다(불변식 I1 이 이 값과 라인 합을 대조한다)
  subtotalMinor BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace CrmWorkspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  quote     CrmQuote       @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  lines     CrmQuoteLine[]

  @@index([quoteId, position])
  @@map("crm_quote_section")
}

// ------------------------------------------------------------
// 그룹 F 매출 인식 장부 — 견적이 아니라 «딜»에 붙는다
//
// 현물은 고객에게 나가는 문서(견적서)의 개념이 아니라
// **우리가 매출을 얼마로 인식하느냐**의 문제다. 그래서 여기 산다.
// ------------------------------------------------------------

/// 재원 구성. 국가 과제에서만 쓰인다 — 보통 딜에는 행이 없다.
///
/// 성질(현금 유입·회계 수익·별도 계좌)은 **sourceType 에서 파생**한다.
/// 행마다 손으로 넣으면 종류와 성질이 언젠가 어긋난다.
model CrmFundingSource {
  id          String               @id @default(cuid())
  workspaceId String
  dealId      String
  sourceType  CrmFundingSourceType
  amountMinor BigInt               @default(0)
  /// 부처·지자체 이름. 정산 서류에 그대로 쓰인다
  agencyName  String?
  /// 연차 배분은 여기서 **계산**한다 — yearAllocationJson 을 손으로 넣지 않는다
  startDate   DateTime?
  endDate     DateTime?
  position    Int                  @default(0)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  deal CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([workspaceId, dealId])
  @@map("crm_funding_source")
}

/// 현물 명세 — «별도로 셋업»의 실물.
///
/// 숫자 한 칸으로 두면 다음 달에 그 2.6억이 뭐였는지 아무도 모른다.
/// «장부가 명확해야 해»는 **무엇을 뺐나**가 남아야 한다는 뜻이었다.
///
/// 관계는 **소유(owns)** — 딜이 없으면 존재 이유가 없다(Cascade).
/// 민감도는 **restricted** — 평가액 명세로 인건비 단가를 역산할 수 있다.
model CrmInKind {
  id          String        @id @default(cuid())
  workspaceId String
  dealId      String
  kind        CrmInKindKind
  name        String
  valueMinor  BigInt        @default(0)
  quantity    Decimal?      @db.Decimal(12, 3)
  unit        String?
  /// 환산 근거 — «연봉 × 참여율 × 기간». 정산 때 그대로 쓰인다(법령상 산정근거 필수)
  basisNote   String?
  /// 연차 배분의 근거. 현물은 협약으로 고정되지 않고 실제 투입에 따라 매년 정산된다
  startDate   DateTime?
  endDate     DateTime?
  position    Int           @default(0)
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  deal CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([workspaceId, dealId, position])
  @@map("crm_in_kind")
}

/// 딜 금액이 왜 바뀌었나. 파이프라인 총액이 출렁이는 이유를 나중에 설명할 수 있어야 한다
model CrmDealAmountHistory {
  id            String   @id @default(cuid())
  workspaceId   String
  dealId        String
  /// budget · quoted · contract · booked · inKind
  field         String
  fromMinor     BigInt?
  toMinor       BigInt?
  reason        String?
  sourceQuoteId String?
  changedById   String?
  changedAt     DateTime @default(now())

  deal CrmDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([workspaceId, dealId, changedAt])
  @@map("crm_deal_amount_history")
}

/// 우리 회사 — 견적서 헤더에 찍히는 것. 지금은 저장할 자리가 0곳이다
/// ⚠️ 모델 이름이 `Crm` 으로 시작해야 한다 — workspace-guard 의 isCrmModel 이
/// 접두사로 판정하므로, 다른 이름이면 워크스페이스 필터가 **주입되지 않는다**.
/// 표 이름은 da_company_profile 그대로 둔다(@@map).
model CrmCompanyProfile {
  id                  String   @id @default(cuid())
  workspaceId         String   @unique
  name                String
  ceoName             String?
  bizRegNo            String?
  address             String?
  tel                 String?
  fax                 String?
  email               String?
  /// 직인은 «생략» 고정(결정 4) — 이미지 업로드·권한 설계가 통째로 빠진다
  sealMode            String   @default("OMIT")
  quotePrefix         String   @default("DA")
  logoUrl             String?
  defaultPaymentTerms String?
  defaultValidDays    Int      @default(10)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("da_company_profile")
}

/// 첨부 — 어디에나 붙는다. **민감도를 함께 갖는다**.
///
/// 매입 견적서를 딜 첨부함에 그냥 두면 원가를 못 보는 사람도 파일은 열 수 있다.
/// 등급은 lib/crm/security/sensitivity.ts 와 같은 말을 쓴다.
model CrmAttachment {
  id           String              @id @default(cuid())
  workspaceId  String
  targetType   CrmAttachmentTarget
  targetId     String
  fileUrl      String
  fileName     String
  mimeType     String?
  sizeBytes    Int?
  kind         CrmAttachmentKind   @default(OTHER)
  sensitivity  CrmSensitivity      @default(INTERNAL)
  ocrStatus    String?
  ocrResultJson Json?
  uploadedById String?
  createdAt    DateTime            @default(now())
  deletedAt    DateTime?

  @@index([workspaceId, targetType, targetId])
  @@map("crm_attachment")
}

// Phase 2 예정(본 파일에 미포함): CrmAutomation, CrmAutomationRun, CrmEnrichmentCache,
// CrmEmbedding(pgvector Unsupported 타입), CrmSavedView, CrmTag, CrmWebhook, CrmApiKey


/// 견적 라인 종류 여섯 (기획 「원가에서 견적까지」 §08)
enum CrmQuoteLineKind {
  USAGE    // 사용량: GPU-hour 처럼 쓴 만큼
  QUANTITY // 수량: 개수 × 단가
  EFFORT   // 공수: M/M × 등급 단가 — 역할·등급이 함께 붙는다
  LICENSE  // 라이선스: User × 기간
  PERIOD   // 기간요금: 월 단가 × 개월
  RATIO    // 비율: 다른 라인의 N%
}

/// 원가 갈래 열. 표준 원가회계 분류를 그대로 쓴다 —
/// 우리가 지어내면 회계·세무와 말이 안 통한다(기획 §03)
enum CrmCostCategory {
  MATERIAL    // 재료비 — 직접비
  LABOR       // 노무비 — 직접비. M/M × 등급단가
  EXPENSE     // 경비 — 직접비
  SUBCONTRACT // 하도급 — 외주비
  PARTNER_FEE // 파트너 수수료 — 외주비. 매출·원가의 %
  OVERHEAD    // 일반관리비 — 간접비. 매출의 %
  INFRA       // 공통 인프라 — 간접비
  FINANCE     // 금융비용 — 기간·위험
  WARRANTY    // 하자보수 충당 — 기간·위험. 무상이지만 원가는 든다
  CONTINGENCY // 예비비 — 기간·위험
}

/// 원가 시점 셋 — 같은 원가를 세 번 본다.
/// 추정과 실적의 차이가 **다음 견적의 정확도**가 된다
enum CrmCostStage {
  ESTIMATE  // 추정: 견적 시점
  COMMITTED // 확정: 계약 시점. 매입 견적서·계약서로 고정
  ACTUAL    // 실적: 집행 시점
}

/// 원가를 어떻게 넣었나 — 무엇으로 넣든 amountMinor 로 수렴한다
enum CrmCostInputMode {
  AMOUNT // 금액을 직접
  EFFORT // M/M × 등급 단가
  RATIO  // 매출(또는 원가)의 %
}

/// 인건비 등급 — 「고급 소프트웨어 엔지니어 1.0 M/M」의 단가가 여기서 온다
model CrmLaborGrade {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String   // 초급·중급·고급·특급
  roleLabel       String?  // 소프트웨어 엔지니어 · UI/UX 디자이너 · PM
  /// 우리가 쓰는 원가 (대외비)
  costPerMmMinor  BigInt   @default(0)
  /// 고객에게 제시하는 단가. 없으면 원가에 마진을 얹는다
  pricePerMmMinor BigInt?
  currency        String   @default("KRW") @db.Char(3)
  position        Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  costs      CrmDealCost[]
  quoteLines CrmQuoteLine[]

  @@index([workspaceId, position])
  @@map("crm_labor_grade")
}

/// 딜 원가 — **딜에 붙는다.** 견적 라인과는 선택적으로 연결된다.
/// 견적 없이 원가만 쌓아도 되고, 나중에 견적을 만들어 연결하면 그때부터 마진이 계산된다
/// (기획 결정 6: 순서 무관 · 데이터로 갖고 있다 반영)
model CrmDealCost {
  id            String   @id @default(cuid())
  workspaceId   String
  dealId        String
  quoteLineId   String?

  category      CrmCostCategory
  stage         CrmCostStage     @default(ESTIMATE)
  inputMode     CrmCostInputMode @default(AMOUNT)

  name          String
  descriptionMd String?

  /// 계산 결과. 입력 방식이 무엇이든 여기로 수렴한다
  amountMinor   BigInt   @default(0)
  currency      String   @default("KRW") @db.Char(3)

  /// EFFORT 로 넣었을 때
  laborGradeId  String?
  effortMm      Decimal? @db.Decimal(10, 2)

  /// RATIO 로 넣었을 때
  ratioPct      Decimal? @db.Decimal(7, 4)
  ratioBase     String?  // 'REVENUE' | 'COST'

  /// 근거. 「추정」이라도 왜 그 숫자인지는 남는다
  basisNote     String?

  createdById   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  deal       CrmDeal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  quoteLine  CrmQuoteLine?  @relation(fields: [quoteLineId], references: [id], onDelete: SetNull)
  laborGrade CrmLaborGrade? @relation(fields: [laborGradeId], references: [id], onDelete: SetNull)

  @@index([dealId, category])
  @@index([quoteLineId])
  @@map("crm_deal_cost")
}


/// 거래 조건 항목 — 사업 스타일마다 조건이 다르다.
/// 관리자가 하나씩 등록하고 영업이 견적마다 고른다
/// (한 덩어리 텍스트면 GPU 조건이 SI 견적서에도 나간다)
model CrmQuoteTerm {
  id           String   @id @default(cuid())
  workspaceId  String
  /// 목록에서 고를 때 보이는 이름. 본문이 길어 그대로는 못 고른다
  title        String
  /// 견적서에 실제로 인쇄되는 문장
  body         String
  /// 이 사업 유형에서 주로 쓰는 조건. null 이면 모든 유형에서 보인다
  businessType CrmBusinessType?
  /// 새 견적을 만들 때 기본으로 켜지는가
  isDefault    Boolean  @default(false)
  position     Int      @default(0)
  isActive     Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  @@index([workspaceId, position])
  @@map("crm_quote_term")
}
