{
  // 스크립트 전용. `lib/**` 의 서버 모듈이 맨 위에 두는 `import 'server-only'` 를
  // 빈 모듈로 돌려 Node 에서도 같은 코드를 부를 수 있게 한다.
  // 부모 tsconfig 는 scripts 를 아예 빼 두므로 exclude 를 비워 다시 집는다.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "@/*": ["./*"],
      "server-only": ["./scripts/server-only.ts"]
    },
    "noEmit": true
  },
  // 새 스크립트는 여기 한 줄을 더한다. 옛 스크립트까지 통째로 집으면
  // 이 설정이 남의 빚을 떠안아 아무도 안 돌린다
  "include": ["./server-only.ts", "./backfill-today-bars.ts"],
  "exclude": []
}
