{
  "compilerOptions": {
    /*
      target 이 없으면 tsc 가 ES5 로 떨어진다. 그러면 Set 이나 Map 을 스프레드하는 평범한 코드가
      TS2802 로 막히고, 이 저장소는 그것을 **네 번** 밟아 매번 Array.from 으로 피했다
      (js-download.ts, review.ts, mask.ts, 그리고 v0.10.0 의 첫 건).

      올려도 되는 이유: 이 tsconfig 는 noEmit 이라 타입 검사에만 쓰인다. target 을 올리면
      쓸 수 있는 것이 늘어날 뿐 줄지 않고, 배포 산출물은 Next 가 자기 target 으로 만든다.
    */
    "target": "es2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-check/types/**/*.ts",
    ".next-e2e-p0041/types/**/*.ts",
    ".next-p0036/types/**/*.ts",
    ".next-p0039/types/**/*.ts",
    ".next-p0040/types/**/*.ts",
    ".next-p0041/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "scripts/**/*"
  ]
}
