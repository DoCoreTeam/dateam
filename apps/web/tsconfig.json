{
  "compilerOptions": {
    /*
      target 이 없으면 tsc 가 ES5 로 떨어진다. 그러면 Set 이나 Map 을 스프레드하는 평범한 코드가
      TS2802 로 막히고, 이 저장소는 그것을 **네 번** 밟아 매번 Array.from 으로 피했다
      (js-download.ts, review.ts, mask.ts, 그리고 v0.10.0 의 첫 건).

      올려도 되는 이유: 이 tsconfig 는 noEmit 이라 타입 검사에만 쓰인다. target 을 올리면
      쓸 수 있는 것이 늘어날 뿐 줄지 않고, 배포 산출물은 Next 가 자기 target 으로 만든다.
    */
    "target": "es2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  // 소스 디렉터리를 하나씩 적는다. 전에는 저장소 뿌리에서 .ts 를 통째로 훑었고,
  // 그러면 tsc 가 .next 로 시작하는 빌드 산출물까지 들어간다. 세션마다 NEXT_DIST_DIR 로
  // 판을 나눠 쌓은 것이 스물세 벌 40GB 였고, 그 디렉터리 하나를 find 로 훑는 데만
  // 2분이 넘었다. tsc 는 SIGABRT 로 죽었다(실측 2026-09-26) — 완료 정의의
  // 「typecheck 통과」를 아무도 확인할 수 없는 상태였다는 뜻이다.
  //
  // exclude 로 막지 않는 이유: exclude 는 include 를 이기므로 빌드 디렉터리를 막으면
  // Next 가 만든 라우트 타입(.next 아래 types)까지 같이 막힌다. 안 훑는 것이 맞다.
  //
  // 새 디렉터리를 만들면 여기 적어야 검사 대상이 된다. 적는 수고가 40GB 를 훑는
  // 대가보다 싸고, 안 적으면 안 잡힌다는 것이 눈에 보인다.
  "include": [
    // Next 가 빌드할 때 이 줄을 자기 판 이름으로 다시 적는다(NEXT_DIST_DIR 을 쓰면
    // .next-xxx 아래 types 줄이 하나 더 붙는다). 안 쓰는 판 이름은 지운다 —
    // 지워도 next-env.d.ts 의 reference 가 지금 판을 끌어온다
    ".next/types/**/*.ts",
    "app/**/*.ts",
    "app/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "e2e/**/*.ts",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "middleware.ts",
    "next-env.d.ts",
    "prisma/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "scripts/**/*"
  ]
}
