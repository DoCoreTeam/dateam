#!/bin/sh
# 푸시 규칙 — 활성 플랜 중에는 푸시를 막는다 (LOOP.md 부록 「푸시 규칙」)
#
# 왜 여기인가: 푸시 한 번이 Vercel 빌드 한 번이고, 2026-09 실측으로 빌드가 인프라
# 요금의 92.1퍼센트(354시간 74.34달러)였다. 그달 커밋은 1,003건인데 푸시는 111회,
# 푸시 1회당 0.67달러다. 커밋을 쌓아 한 번에 밀면 빌드는 한 번이므로 모으는 쪽이
# 언제나 싸다. 그런데 「모아서 밀어라」를 글로만 두면 안 지켜진다 — 버전 규칙이
# 열일곱 판 동안 안 지켜진 것과 같은 구멍이라, 밀리는 자리에서 막는다.
#
# 활성화: git config core.hooksPath .githooks (클론마다 한 번)

if [ -n "$LOOP_PUSH_NOW" ]; then
  echo "[push-gate] LOOP_PUSH_NOW 로 통과. 무엇을 왜 밀었는지 보고에 적는다 (LOOP.md 부록 푸시 규칙 3)"
  exit 0
fi

# 훅이 보는 플랜은 둘뿐이다 — 기본 플랜과 이 셸이 가리키는 옆 플랜.
# .loop/PLAN*.md 를 전부 훑으면 안 된다: 끝내지 않고 둔 옛 플랜이 「진행중」으로
# 남아 있어(실측 2026-10-08 P0001·P0030·P0052·P0114 넷) 푸시가 영영 막힌다.
plan_status() {
  [ -f "$1" ] || return 1
  grep -m1 '^상태:' "$1" 2>/dev/null | sed 's/^상태:[[:space:]]*//'
}

active=""
for f in ".loop/PLAN.md" ${LOOP_PLAN_FILE:+".loop/$LOOP_PLAN_FILE"}; do
  st=$(plan_status "$f") || continue
  case "$st" in
    완료*|중단*|'') continue ;;
  esac
  id=$(grep -m1 '^플랜 ID:' "$f" 2>/dev/null | sed 's/^플랜 ID:[[:space:]]*//')
  active="$active $f($id $st)"
done

[ -z "$active" ] && exit 0

ahead=$(git rev-list --count @{u}..HEAD 2>/dev/null || git rev-list --count origin/main..HEAD 2>/dev/null || echo "?")

echo "[push-gate] 활성 플랜이 있어 푸시를 막았다:$active"
echo "[push-gate] 지금 밀면 빌드가 한 번 더 돈다. 미푸시 커밋 ${ahead}개는 플랜이 끝날 때 한 번에 나간다."
echo "[push-gate] 순서: 전 항목 통과 -> loop final --result pass -> git push"
echo "[push-gate] 운영이 멈춘 것을 되살리는 긴급 푸시라면: LOOP_PUSH_NOW=1 git push (사유를 보고에 적는다)"
echo "[push-gate] 근거: LOOP.md 부록 「푸시 규칙」, 2026-09 빌드 354시간 74.34달러로 인프라의 92.1퍼센트"
exit 1
