#!/bin/sh
# 푸시 타이밍 — 무엇을 고쳤는지로 가른다 (LOOP.md 부록 「푸시 규칙」)
#
# 판정 한 줄: 지금 안 밀면 사용자가 계속 막히나
#   예면 「푸시: 즉시」라 여기서 통과시킨다. 고친 것이 안 가면 사용자는 막힌 채로 있고,
#   요금 0.67달러를 아끼려고 반나절을 막아 두는 것은 바꿀 값이 아니다.
#   아니오면 「푸시: 모음」이라 막는다. 2026-09 실측으로 빌드가 인프라 요금의
#   92.1퍼센트(354시간 74.34달러)였고, 그달 커밋 1,003건에 푸시는 111회였다.
#   빌드는 푸시에 담긴 마지막 커밋 하나만 굽는다 — 모으면 한 번이고 나눠 밀면 그 수만큼이다.
#
# 판정은 플랜을 세울 때 한 번 하고 헤더 「푸시:」 한 칸에 적는다. 여기서는 그 줄을 읽기만 한다.
# 활성화: git config core.hooksPath .githooks (클론마다 한 번)

if [ -n "$LOOP_PUSH_NOW" ]; then
  echo "[push-gate] LOOP_PUSH_NOW 로 통과. 무엇을 왜 밀었는지 보고에 적는다 (모음 플랜 도중 운영 결함을 고쳤을 때의 정상 경로)"
  exit 0
fi

# 훅이 보는 플랜은 둘뿐이다 — 기본 플랜과 이 셸이 가리키는 옆 플랜.
# .loop/PLAN*.md 를 전부 훑으면 안 된다: 끝내지 않고 둔 옛 플랜이 「진행중」으로
# 남아 있어(실측 2026-10-08 P0001, P0030, P0052, P0114 넷) 푸시가 영영 막힌다.
plan_field() {
  [ -f "$1" ] || return 1
  grep -m1 "^$2:" "$1" 2>/dev/null | sed "s/^$2:[[:space:]]*//"
}

held=""
for f in ".loop/PLAN.md" ${LOOP_PLAN_FILE:+".loop/$LOOP_PLAN_FILE"}; do
  st=$(plan_field "$f" "상태") || continue
  case "$st" in
    완료*|중단*|'') continue ;;
  esac

  id=$(plan_field "$f" "플랜 ID")
  mode=$(plan_field "$f" "푸시")

  # 즉시는 「지금 안 밀면 사용자가 계속 막힌다」는 뜻이다. 그 판정이 섰으면 여기서 비킨다.
  # 쌓여 있던 모음 커밋도 이 푸시에 같이 실려 나간다, 빌드는 한 번이다
  if [ "$mode" = "즉시" ]; then
    echo "[push-gate] $f ($id) 가 「푸시: 즉시」라 통과. 운영에 닿는 수정은 모으지 않는다"
    exit 0
  fi

  # 푸시 줄이 없는 옛 플랜은 모음으로 본다 — 모르는 것을 통과시키면 가드가 아니다
  case "$mode" in
    모음) note="모음" ;;
    '')   note="푸시 줄 없음, 모음으로 봄" ;;
    *)    note="알 수 없는 값 $mode, 모음으로 봄" ;;
  esac
  held="$held $f($id $st, $note)"
done

# 활성 플랜이 없어도 막는다. 예전에는 여기서 통과시켰고, 그래서 모음 플랜도
# final 직후에는 언제나 밀렸다 — 실측 2026-10-20 하루 푸시 12회 (사용자 지시 ins_0288)
[ -z "$held" ] && held=" 활성 플랜 없음 또는 끝난 플랜"

ahead=$(git rev-list --count @{u}..HEAD 2>/dev/null || git rev-list --count origin/main..HEAD 2>/dev/null || echo "?")

echo "[push-gate] 모음 플랜은 완료해도 밀지 않는다, 푸시를 막았다:$held"
echo "[push-gate] 미푸시 커밋 ${ahead}개는 다음 운영 결함 수정이나 사용자가 밀라고 할 때 한 번에 나간다"
echo "[push-gate] 지금 밀어야 한다면 둘 중 하나:"
echo "[push-gate]   운영 결함 수정이거나 사용자가 밀라고 했다: LOOP_PUSH_NOW=1 git push (사유를 보고에 적는다)"
echo "[push-gate]   플랜 전체가 운영 결함 수정이다: 헤더의 「푸시: 모음」을 「푸시: 즉시」로 고치고 loop plan revise"
echo "[push-gate] 근거: LOOP.md 부록 「푸시 규칙」, 2026-09 빌드 354시간 74.34달러로 인프라의 92.1퍼센트"
exit 1
